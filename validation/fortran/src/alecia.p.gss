method,model,idata,nobs,ny,nx,nr,ntime,nfac,irhobessel,ifcond1,niter,
       stp1,nrst,ifsattr,ifwvdum
nseg
coef
icoef
alabel

alabel  = labels of variables
coef    = initial value of coefficients
icoef   = restriction flags for coefficients to estimate (0 => no 
          restriction)
idata   = data set #
ifcond1 = flag for whether to condition on first dependent variable for
          each observation
ifsattr = 0 do not use democracy satisfaction and trust variables
          1 use democracy and trust variables but excluse observations
            with missing values
          2 use democracy and trust variables, interpolate missing
            variables when possible, but exclude otherwise
          3 use democracy and trust variables, interpolate and 
            extrapolate missing variables when possible, exclude 
            otherwise
          4 report possibilities for interpolation and extrapolation 
            of missing democracy and trust variables
ifwvdum = flag for whether to include wave dummies
method  = 0 for test of log likelihood function
          1 for estimation
          2 for estimation of asymptotic covariance matrix
          3 for variable test (vartest)
model   = 1 for simple model
          2 for complex model
nfac    = # factors
niter   = maximum # iterations for each gqopt call
nobs    = # observations
nx      = # explanatory variables
nr      = # draws for simulation
nrst    = maximum # restarts allowed for each gqopt call
nseg    = vector of # different values for ordered discrete dependent 
          variable(s)
ntime   = # time periods
ny      = # dependent variables
stp1    = initial gqopt stepsize
